<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>Проверка знаний: Формирование рельефа Земли | Zadano</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%232563EB'/><text x='46' y='72' font-size='64' font-family='Arial,sans-serif' font-weight='900' fill='white' text-anchor='middle'>Z</text><circle cx='78' cy='70' r='7' fill='%23F59E0B'/></svg>">
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #F5F7FA;
      --card: #FFFFFF;
      --border: #E1E8F0;
      --border-soft: #EDF1F6;
      --accent: #2563EB;
      --accent-soft: #DBE7FB;
      --success: #10B981;
      --success-soft: #D1FAE5;
      --error: #EF4444;
      --error-soft: #FEE2E2;
      --ink: #0F1B3D;
      --ink-2: #2A3654;
      --muted: #6B7A94;
      --radius-lg: 28px;
      --radius-sm: 14px;
      --ease: cubic-bezier(.2,.9,.4,1.1);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      padding: 1rem;
      line-height: 1.6;
    }

    /* ═══ ШАПКА ═══ */
    .topbar {
      max-width: 820px;
      margin: 0 auto 1rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: .6rem .4rem;
    }
    .back {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .55rem 1rem;
      border-radius: 40px;
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--ink);
      text-decoration: none;
      font-size: .85rem;
      font-weight: 600;
      transition: all .2s;
    }
    .back:hover { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
    .back::before { content: '←'; font-weight: 700; }
    .logo {
      margin-left: auto;
      font-size: 1.15rem;
      font-weight: 900;
      letter-spacing: -.04em;
      color: var(--ink);
      text-decoration: none;
      display: flex;
      align-items: center;
    }
    .logo::after { content: '.'; color: var(--accent); font-size: 1.4rem; line-height: 1; margin-left: 1px; }

    /* ═══ ОСНОВНАЯ КАРТОЧКА ═══ */
    .doc {
      max-width: 820px;
      margin: 0 auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 3rem 3rem 2.5rem;
    }

    /* ═══ ЗАГОЛОВОК ═══ */
    .doc-head {
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border-soft);
      margin-bottom: 2rem;
    }
    .doc-eyebrow {
      font-size: .7rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: .6rem;
    }
    h1 {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -.03em;
      line-height: 1.15;
      margin-bottom: .6rem;
    }
    .doc-meta {
      font-size: .82rem;
      color: var(--muted);
      display: flex;
      flex-wrap: wrap;
      gap: .4rem 1.2rem;
      align-items: center;
    }
    .doc-meta span { display: inline-flex; align-items: center; gap: .4rem; }
    .doc-meta span::before { content: '·'; color: var(--accent); font-weight: 800; }
    .doc-meta span:first-child::before { display: none; }

    /* ═══ ВВОДНЫЙ БЛОК ═══ */
    .doc-lead {
      background: var(--accent-soft);
      border-left: 3px solid var(--accent);
      border-radius: 0 12px 12px 0;
      padding: 1rem 1.2rem;
      margin-bottom: 2rem;
      font-size: .92rem;
      color: var(--ink-2);
    }

    /* ═══ СЕКЦИИ КОНСПЕКТА ═══ */
    .doc h2 {
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -.01em;
      margin: 2rem 0 .8rem;
      display: flex;
      align-items: baseline;
      gap: .6rem;
      color: var(--ink);
    }
    .doc h2 .num {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: .8rem;
      font-weight: 700;
      color: var(--accent);
      background: var(--accent-soft);
      padding: .15rem .5rem;
      border-radius: 6px;
      flex-shrink: 0;
    }
    .doc h2:first-of-type { margin-top: 0; }
    .doc p {
      font-size: .92rem;
      color: var(--ink-2);
      margin-bottom: .9rem;
    }
    .doc ul {
      list-style: none;
      margin: .4rem 0 1rem;
      padding: 0;
    }
    .doc ul li {
      position: relative;
      padding-left: 1.4rem;
      font-size: .92rem;
      color: var(--ink-2);
      margin-bottom: .45rem;
    }
    .doc ul li::before {
      content: '';
      position: absolute;
      left: 0;
      top: .65em;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--accent);
    }
    .doc strong { color: var(--ink); font-weight: 700; }
    .doc em { color: var(--muted); font-style: normal; }
    .doc a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
      border-bottom: 1px solid transparent;
      transition: border-color .2s;
    }
    .doc a:hover { border-color: var(--accent); }

    /* ═══ БЛОК ПРОВЕРКИ ЗНАНИЙ ═══ */
    .quiz-section {
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border-soft);
    }
    .quiz-title {
      font-size: 1.2rem;
      font-weight: 800;
      letter-spacing: -.02em;
      display: flex;
      align-items: center;
      gap: .8rem;
      margin-bottom: .4rem;
    }
    .quiz-title .icon {
      background: var(--accent);
      color: white;
      width: 32px; height: 32px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
    }
    .quiz-sub {
      font-size: .88rem;
      color: var(--muted);
      margin-bottom: 1.6rem;
    }

    /* ═══ ВОПРОСЫ ═══ */
    .quiz-item {
      background: #FAFCFF;
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-sm);
      padding: 1.2rem 1.4rem;
      margin-bottom: 1rem;
      transition: border-color .2s;
    }
    .quiz-item.correct { border-color: var(--success); background: var(--success-soft); }
    .quiz-item.wrong { border-color: var(--error); background: var(--error-soft); }

    .q-text {
      font-weight: 600;
      font-size: .95rem;
      color: var(--ink);
      margin-bottom: .8rem;
      display: flex;
      gap: .6rem;
    }
    .q-text .q-num {
      font-family: ui-monospace, monospace;
      font-size: .78rem;
      font-weight: 700;
      color: var(--accent);
      background: var(--accent-soft);
      padding: .1rem .45rem;
      border-radius: 6px;
      flex-shrink: 0;
      height: fit-content;
    }

    .options { display: flex; flex-direction: column; gap: .5rem; margin-bottom: .8rem; }

    .option {
      display: flex;
      align-items: flex-start;
      gap: .7rem;
      padding: .6rem .8rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: white;
      cursor: pointer;
      transition: all .15s;
      font-size: .9rem;
      color: var(--ink-2);
      line-height: 1.4;
      user-select: none;
    }
    .option:hover { border-color: var(--accent); background: var(--accent-soft); }
    .option input[type="radio"] { margin-top: .2rem; accent-color: var(--accent); flex-shrink: 0; }
    .option.selected { border-color: var(--accent); background: var(--accent-soft); }

    /* ═══ ПОЛЕ ВВОДА ═══ */
    .input-row { display: flex; gap: .6rem; margin-bottom: .8rem; flex-wrap: wrap; }
    .input-row input[type="text"] {
      flex: 1;
      min-width: 200px;
      padding: .65rem .9rem;
      border: 1px solid var(--border);
      border-radius: 10px;
      font-family: inherit;
      font-size: .9rem;
      color: var(--ink);
      background: white;
      outline: none;
      transition: border-color .2s;
    }
    .input-row input[type="text"]:focus { border-color: var(--accent); }

    /* ═══ КНОПКИ ═══ */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .45rem;
      padding: .6rem 1.2rem;
      border-radius: 40px;
      border: none;
      font-family: inherit;
      font-size: .85rem;
      font-weight: 700;
      cursor: pointer;
      transition: all .2s;
      background: var(--accent);
      color: white;
    }
    .btn:hover { background: #1D4ED8; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37,99,235,.25); }
    .btn:active { transform: translateY(0); }
    .btn-check {
      background: var(--ink);
      color: white;
      padding: .55rem 1.4rem;
      font-size: .82rem;
    }
    .btn-check:hover { background: #1a2a52; box-shadow: 0 4px 12px rgba(15,27,61,.2); }
    .btn-reset {
      background: transparent;
      color: var(--muted);
      border: 1px solid var(--border);
    }
    .btn-reset:hover { background: var(--bg); color: var(--ink); border-color: var(--muted); box-shadow: none; transform: none; }

    /* ═══ ОБРАТНАЯ СВЯЗЬ ═══ */
    .feedback {
      font-size: .85rem;
      font-weight: 600;
      display: none;
      align-items: center;
      gap: .4rem;
      margin-top: .4rem;
    }
    .feedback.show { display: flex; }
    .feedback.ok { color: var(--success); }
    .feedback.no { color: var(--error); }
    .feedback .mark { font-size: 1.1rem; }

    /* ═══ ИТОГИ ═══ */
    .quiz-result {
      display: none;
      margin-top: 1.5rem;
      padding: 1.2rem 1.5rem;
      border-radius: var(--radius-sm);
      background: var(--accent-soft);
      border: 1px solid var(--accent);
      text-align: center;
      font-size: 1rem;
      font-weight: 700;
      color: var(--ink);
    }
    .quiz-result.show { display: block; }
    .quiz-result .score { color: var(--accent); font-size: 1.3rem; }

    .quiz-actions {
      display: flex;
      gap: .8rem;
      flex-wrap: wrap;
      margin-top: 1.2rem;
      align-items: center;
    }

    /* ═══ ПОДВАЛ ═══ */
    .foot {
      max-width: 820px;
      margin: 1rem auto 0;
      padding: 0 .4rem 2rem;
      font-size: .75rem;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: .5rem;
    }
    .foot a { color: var(--muted); text-decoration: none; transition: color .2s; }
    .foot a:hover { color: var(--accent); }

    /* ═══ АДАПТИВ ═══ */
    @media (max-width: 640px) {
      body { padding: .6rem; }
      .doc { padding: 2rem 1.4rem 1.6rem; border-radius: 20px; }
      h1 { font-size: 1.5rem; }
      .doc h2 { font-size: 1rem; margin-top: 1.6rem; }
      .doc h2 .num { font-size: .75rem; }
      .doc p, .doc ul li { font-size: .88rem; }
      .topbar { padding: .4rem 0; }
      .back { font-size: .8rem; padding: .5rem .9rem; }
      .logo { font-size: 1rem; }
      .foot { padding: 0 0 1.5rem; }
      .quiz-item { padding: 1rem 1rem; }
      .option { font-size: .85rem; padding: .5rem .7rem; }
      .quiz-title { font-size: 1.05rem; }
      .quiz-title .icon { width: 28px; height: 28px; font-size: .85rem; }
      .input-row input[type="text"] { font-size: .85rem; }
    }
  </style>
</head>
<body>

  <div class="topbar">
    <a href="/" class="back">на главную</a>
    <a href="/" class="logo">Zadano</a>
  </div>

  <main class="doc">

    <div class="doc-head">
      <div class="doc-eyebrow">Проверка знаний · География</div>
      <h1>Формирование рельефа Земли</h1>
      <div class="doc-meta">
        <span>7 класс</span>
        <span>28 сентября</span>
        <span>10 вопросов</span>
      </div>
    </div>

    <p class="doc-lead">
      Прочитайте конспект, затем ответьте на вопросы для самопроверки. Отмечайте варианты, вводите слова — и узнайте, насколько хорошо вы усвоили тему.
    </p>

    <!-- ═══ КОНСПЕКТ ═══ -->
    <h2><span class="num">01</span> Основные понятия</h2>
    <ul>
      <li><strong>Рельеф</strong> — совокупность всех неровностей земной поверхности (горы, равнины, впадины, холмы и т.д.).</li>
    </ul>

    <h2><span class="num">02</span> Внутренние (эндогенные) процессы</h2>
    <p>Процессы, происходящие внутри Земли. Они создают крупные формы рельефа и влияют на формирование полезных ископаемых.</p>
    <ul>
      <li><strong>Эндогенные процессы:</strong> тектоника (движения земной коры), вулканизм (извержения магмы), движение по трещинам (разломам) земной коры.</li>
      <li><strong>Основные тектонические структуры:</strong> платформы (устойчивые участки) и складчатые области (подвижные пояса).</li>
    </ul>

    <p><strong>Движения земной коры</strong></p>
    <p><em>Схема: Внутренние процессы → Вертикальные движения / Горизонтальные движения</em></p>

    <p><strong>А. Вертикальные движения</strong> (происходят медленно, меняют высоту участков суши)</p>
    <ul>
      <li><strong>Горст</strong> — приподнятый, обычно вытянутый участок земной коры, ограниченный круто наклоненными разломами.
        <br><em>Схема: ступенчатое поднятие блоков вверх.</em>
      </li>
      <li><strong>Сброс</strong> — смещение блоков земной коры друг относительно друга в зоне разлома.
        <br><em>Схема: вертикальное смещение блоков (один блок опускается, другой остается на месте или поднимается).</em>
      </li>
    </ul>

    <p><strong>Б. Горизонтальные движения</strong> (происходят при столкновении или расхождении литосферных плит)</p>
    <ul>
      <li><strong>Грабен</strong> — участок земной коры, обычно вытянутой формы, опущенный по разломам относительно окружающих участков.
        <br><em>Схема: опущенный блок между двумя разломами (пример: озеро Байкал, Красное море).</em>
      </li>
    </ul>

    <p><em>Примечание: Грабен — результат вертикальных движений (опускание блока). Горизонтальные движения формируют складки (сжатие) и раздвижение плит (спрединг).</em></p>

    <h2><span class="num">03</span> Внешние (экзогенные) процессы</h2>
    <p>Процессы, происходящие на поверхности Земли под действием солнечной энергии, силы тяжести, воды, ветра и живых организмов. Они разрушают крупные формы рельефа и создают мелкие.</p>
    <ul>
      <li><strong>Выветривание</strong> — процесс изменения и разрушения минералов и горных пород на суше под воздействием внешних факторов.</li>
    </ul>

    <p><strong>Виды выветривания</strong></p>
    <ul>
      <li><strong>Физическое</strong> — механическое разрушение (например, расширение воды при замерзании в трещинах).</li>
      <li><strong>Химическое</strong> — растворение и изменение состава пород под действием воды, кислот, кислорода.</li>
      <li><strong>Биологическое</strong> — разрушение пород растениями, животными и микроорганизмами.</li>
    </ul>

    <p><strong>Геологическая работа внешних сил</strong></p>
    <ul>
      <li><strong>Работа текучих вод:</strong> образование оврагов, речных долин, промоин.</li>
      <li><strong>Работа ледников:</strong> создание друмлинов (холмы), озов (валы из песка и гравия), бараньих лбов (скалы со сглаженной поверхностью).</li>
      <li><strong>Работа ветра:</strong> формирование барханов (в пустынях) и дюн (на берегу моря).</li>
    </ul>

    <!-- ═══ БЛОК ПРОВЕРКИ ЗНАНИЙ ═══ -->
    <div class="quiz-section" id="quiz">
      <div class="quiz-title">
        <span class="icon">✓</span>
        Проверь себя
      </div>
      <p class="quiz-sub">Ответьте на все вопросы и нажмите «Проверить».</p>

      <!-- Вопрос 1 -->
      <div class="quiz-item" data-q="1">
        <div class="q-text"><span class="q-num">1</span> Что такое рельеф?</div>
        <div class="options">
          <label class="option"><input type="radio" name="q1" value="a"> Совокупность всех неровностей земной поверхности</label>
          <label class="option"><input type="radio" name="q1" value="b"> Совокупность горных пород и минералов</label>
          <label class="option"><input type="radio" name="q1" value="c"> Процессы, происходящие внутри Земли</label>
        </div>
        <div class="feedback" id="fb1"></div>
      </div>

      <!-- Вопрос 2 -->
      <div class="quiz-item" data-q="2">
        <div class="q-text"><span class="q-num">2</span> Какие процессы создают крупные формы рельефа?</div>
        <div class="options">
          <label class="option"><input type="radio" name="q2" value="a"> Внешние (экзогенные)</label>
          <label class="option"><input type="radio" name="q2" value="b"> Внутренние (эндогенные)</label>
          <label class="option"><input type="radio" name="q2" value="c"> Только выветривание</label>
        </div>
        <div class="feedback" id="fb2"></div>
      </div>

      <!-- Вопрос 3 -->
      <div class="quiz-item" data-q="3">
        <div class="q-text"><span class="q-num">3</span> Что такое горст?</div>
        <div class="options">
          <label class="option"><input type="radio" name="q3" value="a"> Опущенный блок земной коры между разломами</label>
          <label class="option"><input type="radio" name="q3" value="b"> Приподнятый участок земной коры, ограниченный разломами</label>
          <label class="option"><input type="radio" name="q3" value="c"> Складка, образованная при сжатии</label>
        </div>
        <div class="feedback" id="fb3"></div>
      </div>

      <!-- Вопрос 4 -->
      <div class="quiz-item" data-q="4">
        <div class="q-text"><span class="q-num">4</span> Какой процесс формирует грабен?</div>
        <div class="options">
          <label class="option"><input type="radio" name="q4" value="a"> Горизонтальное сжатие</label>
          <label class="option"><input type="radio" name="q4" value="b"> Вертикальное опускание блока по разломам</label>
          <label class="option"><input type="radio" name="q4" value="c"> Работа ветра</label>
        </div>
        <div class="feedback" id="fb4"></div>
      </div>

      <!-- Вопрос 5 -->
      <div class="quiz-item" data-q="5">
        <div class="q-text"><span class="q-num">5</span> Что такое выветривание?</div>
        <div class="options">
          <label class="option"><input type="radio" name="q5" value="a"> Процесс изменения и разрушения горных пород под действием внешних факторов</label>
          <label class="option"><input type="radio" name="q5" value="b"> Извержение вулкана</label>
          <label class="option"><input type="radio" name="q5" value="c"> Движение литосферных плит</label>
        </div>
        <div class="feedback" id="fb5"></div>
      </div>

      <!-- Вопрос 6 -->
      <div class="quiz-item" data-q="6">
        <div class="q-text"><span class="q-num">6</span> Какое выветривание связано с расширением воды при замерзании в трещинах?</div>
